{
    "name": "ansible-dev-tools-podman",
    "image": "registry.redhat.io/ansible-automation-platform-25/ansible-dev-tools-rhel8:latest",
    "containerUser": "root",
    "runArgs": [
        "--cap-add=SYS_ADMIN",
        "--cap-add=SYS_RESOURCE",
        "--cap-add=CAP_MKNOD",
        "--device",
        "/dev/fuse",
        "--hostname=ansible-dev-tools-podman",
        "--security-opt",
        "apparmor=unconfined"
    ],
    "customizations": {
        "vscode": {
            "extensions": ["redhat.ansible", "redhat.vscode-redhat-account"]
        }
    }
}